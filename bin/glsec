#!/bin/sh
# Copyright The glsec Authors
# SPDX-License-Identifier: Apache-2.0
# glsec Claude Code plugin wrapper.
#
# Resolves a real glsec binary WITHOUT requiring a Go toolchain, in order of
# preference:
#   1. an existing glsec already on PATH (Homebrew / go install / manual) that
#      is at least VERSION, skipping this wrapper itself and any relative PATH
#      entry;
#   2. a previously downloaded copy in the cache;
#   3. the prebuilt release asset from GitHub Releases, verified against
#      checksums.txt and, when cosign or an authenticated gh is installed,
#      against its signed build provenance; then extracted, cached and exec'd.
#
# Supports linux + darwin only. VERSION is kept in lockstep with the release.
set -eu

VERSION="1.25.0"
REPO="glsec/glsec"

hint() {
	cat >&2 <<EOF
glsec: $1

Install glsec one of these ways, then re-run:
  - Go:        go install github.com/glsec/glsec/cmd/glsec@latest
  - Binaries:  https://github.com/glsec/glsec/releases
EOF
	exit 1
}

# abspath prints the absolute path of its argument (dir resolved, basename kept).
abspath() {
	_d=$(dirname -- "$1")
	_b=$(basename -- "$1")
	_r=$(CDPATH= cd -- "$_d" 2>/dev/null && pwd -P) || return 1
	printf '%s/%s\n' "$_r" "$_b"
}

self=$(abspath "$0" 2>/dev/null || printf '%s\n' "$0")

# version_at_least reports whether version $1 (X.Y.Z, optionally with a leading
# v or a -suffix) is at least $2.
version_at_least() {
	case "${1#v}" in
		[0-9]*.[0-9]*.[0-9]*) ;;
		*) return 1 ;;
	esac
	awk -v a="${1#v}" -v b="$2" 'BEGIN {
		split(a, x, "."); split(b, y, ".")
		for (i = 1; i <= 3; i++) {
			if (x[i] + 0 > y[i] + 0) exit 0
			if (x[i] + 0 < y[i] + 0) exit 1
		}
		exit 0
	}'
}

# 1) An existing glsec elsewhere on PATH (not this wrapper). The plugin runs in
# whatever project is open, so an empty or relative PATH entry, which means
# that project's directory, is skipped: it could hold a glsec of its own. An
# older glsec is skipped too, since it may lack fixes this release has. The
# lookup runs in a subshell (so the local IFS change is contained) and prints
# the first match.
found=$(
	IFS=:
	for d in $PATH; do
		# The leading ( keeps the bash 3.2 that is macOS's /bin/sh from reading
		# the pattern's ) as the end of the $( ) around this loop.
		case "$d" in
			(/*) ;;
			(*) continue ;;
		esac
		cand="$d/glsec"
		[ -x "$cand" ] || continue
		[ "$(abspath "$cand" 2>/dev/null || true)" = "$self" ] && continue
		v=$("$cand" --version 2>/dev/null | awk '{print $2}') || continue
		version_at_least "$v" "$VERSION" || continue
		printf '%s\n' "$cand"
		break
	done
)
if [ -n "$found" ]; then
	exec "$found" "$@"
fi

# Map the platform to the release asset's os/arch tokens.
os=$(uname -s)
case "$os" in
	Linux) os=linux ;;
	Darwin) os=darwin ;;
	*) hint "unsupported OS '$os' (this plugin supports linux and darwin only)" ;;
esac

arch=$(uname -m)
case "$arch" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64) arch=arm64 ;;
	*) hint "unsupported architecture '$arch'" ;;
esac

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/glsec"
cached="$cache_dir/glsec-$VERSION-$os-$arch"

# 2) Cached download from a previous run.
if [ -x "$cached" ]; then
	exec "$cached" "$@"
fi

# 3) Download, verify, cache.
asset="glsec_${VERSION}_${os}_${arch}.tar.gz"
base="https://github.com/$REPO/releases/download/v$VERSION"

if command -v curl >/dev/null 2>&1; then
	dl() { curl -fsSL "$1" -o "$2"; }
elif command -v wget >/dev/null 2>&1; then
	dl() { wget -qO "$2" "$1"; }
else
	hint "need curl or wget to download the glsec binary"
fi

if command -v sha256sum >/dev/null 2>&1; then
	sha256() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
	sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
else
	hint "need sha256sum or shasum to verify the download"
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/glsec.XXXXXX") || hint "could not create a temp directory"
trap 'rm -rf "$tmp"' EXIT INT TERM

dl "$base/$asset" "$tmp/$asset" || hint "failed to download $asset from $base"
dl "$base/checksums.txt" "$tmp/checksums.txt" || hint "failed to download checksums.txt from $base"

want=$(awk -v f="$asset" '$2 == f {print $1}' "$tmp/checksums.txt")
[ -n "$want" ] || hint "no checksum for $asset in checksums.txt"
got=$(sha256 "$tmp/$asset")
[ "$want" = "$got" ] || hint "checksum mismatch for $asset (expected $want, got $got)"

# checksums.txt comes from the same place as the archive, so it catches a broken
# download but not a replaced release. The signed provenance does: it proves
# the archive was built by glsec's release build workflow.
signer="glsec/glsec/.github/workflows/build-release.yml"
if command -v cosign >/dev/null 2>&1; then
	bundle="glsec_${VERSION}.sigstore.json"
	dl "$base/$bundle" "$tmp/$bundle" || hint "failed to download $bundle from $base"
	cosign verify-blob-attestation --bundle "$tmp/$bundle" --new-bundle-format --type slsaprovenance1 \
		--certificate-identity-regexp "^https://github.com/$signer@refs/tags/v" \
		--certificate-oidc-issuer https://token.actions.githubusercontent.com \
		"$tmp/$asset" >/dev/null 2>&1 || hint "provenance verification with cosign failed for $asset"
elif command -v gh >/dev/null 2>&1 && gh attestation --help >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
	gh attestation verify "$tmp/$asset" --owner glsec --signer-workflow "$signer" >/dev/null 2>&1 ||
		hint "provenance verification with gh failed for $asset"
else
	echo "glsec: verified $asset against checksums.txt only; install cosign or the GitHub CLI to verify its build provenance too" >&2
fi

tar -xzf "$tmp/$asset" -C "$tmp" || hint "failed to extract $asset"
[ -f "$tmp/glsec" ] || hint "glsec binary not found inside $asset"

mkdir -p "$cache_dir"
chmod +x "$tmp/glsec"
# Move into place atomically where possible; fall back to copy across devices.
mv "$tmp/glsec" "$cached" 2>/dev/null || cp "$tmp/glsec" "$cached" || hint "failed to install glsec into $cache_dir"

exec "$cached" "$@"
